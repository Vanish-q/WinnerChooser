<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WinnerChooser.App.Pages.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#000000">

    <Grid RowDefinitions="Auto,*"
          Padding="24,40,24,24"
          RowSpacing="28">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

            <VerticalStackLayout Grid.Column="0" Spacing="6">
                <Label x:Name="TitleLabel"
                       Text="Выбор победителя"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#FFFFFF"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="ModesLabel"
                       Text="Режимы"
                       FontSize="16"
                       TextColor="#9E9E9E" />
            </VerticalStackLayout>

            <ImageButton x:Name="SettingsButton"
                         Grid.Column="1"
                         Source="settings.png"
                         Clicked="OnSettingsClicked"
                         WidthRequest="48"
                         HeightRequest="48"
                         Padding="12"
                         BackgroundColor="Transparent"
                         VerticalOptions="Start" />

        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="12" VerticalOptions="Start">

            <Button x:Name="ModeDrawButton"
                    Text="Жребий"
                    Clicked="OnWinnerPickerClicked"
                    HeightRequest="72"
                    FontSize="20"
                    CornerRadius="16"
                    BackgroundColor="#1A1A1A"
                    TextColor="#FFFFFF"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>

    </Grid>

</ContentPage>
